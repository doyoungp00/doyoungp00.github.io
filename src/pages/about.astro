---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SlashList from "../components/SlashList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      h1 {
        font-size: 2rem;
      }
      .header-block {
        display: flex;
        width: 100%;
        p {
          flex-basis: 50%;
          font-size: 1.4rem;
        }
        .row {
          display: flex;
          flex-direction: column;
          flex-basis: 50%;
          justify-content: center;
          text-align: right;
          font-size: 16px;
        }
      }
      .section {
        margin-top: 36px;
        h1 {
          font-size: 1.4rem;
          font-weight: 500;
          margin-bottom: 1.5rem;
        }
        table {
          width: 100%;
          table-layout: fixed;
          margin-left: 1rem;
        }
        td:first-child {
          width: min-content;
          white-space: nowrap;
          padding-right: 2rem;
          font-weight: 500;
        }
      }
      .subsection {
        margin-left: 1rem;
        h1 {
          font-size: 1.2rem;
          font-weight: 400;
          margin-bottom: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <h1>Doyoung Park</h1>
        <div class="header-block">
          <p>Junior Developer</p>
          <div class="row">
            <span>doyoungp.00@gmail.com</span>
            <span>Suwon, South Korea</span>
          </div>
        </div>
        <hr />
        <div class="section">
          <h1>Technical Skills</h1>
          <table>
            <tbody>
              <tr>
                <td>Languages</td>
                <td>
                  <SlashList items={["C#", "TypeScript", "Java"]} />
                </td>
              </tr>
              <tr>
                <td>Frontend</td>
                <td><SlashList items={["React", "Tailwind"]} /></td>
              </tr>
              <tr>
                <td>Backend</td>
                <td><SlashList items={["Spring Boot", "MySQL"]} /></td>
              </tr>
              <tr>
                <td>Cloud</td>
                <td><SlashList items={["AWS", "Firebase"]} /></td>
              </tr>
              <tr>
                <td>Others</td>
                <td><SlashList items={["Git", "Linux(Debian, FreeBSD)"]} /></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="section">
          <h1>Projects</h1>
          <div class="subsection">
            <h1>Mobile App Development</h1>
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
