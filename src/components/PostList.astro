---
import FormattedDate from "@/components/FormattedDate.astro";
import ImageWithBackground from "@/components/ImageWithBackground.astro";
import paths from "@/utils/paths";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import type { getCollection } from "astro:content";
type Posts = Awaited<ReturnType<typeof getCollection<"posts">>>;
interface Props {
  posts: Posts;
}
const posts: Posts = Astro.props.posts;
---

<div class="tag-search-area">
  <a href={`/${paths.tags.url}`} class="see-all">see all tags →</a>
  <div class="search">
    <PagefindConfig />
    <pagefind-searchbox></pagefind-searchbox>
  </div>
</div>
<ul>
  {
    posts.map((post) => (
      <li>
        <a href={`/${paths.posts.url}/${post.id}/`}>
          {post.data.heroImage && (
            <div class="thumbnail">
              <ImageWithBackground src={post.data.heroImage} />
            </div>
          )}
          <h5 class="title">{post.data.title}</h5>
          <p class="date">
            <FormattedDate date={post.data.pubDate} />
          </p>
        </a>
      </li>
    ))
  }
</ul>
<style>
  .tag-search-area {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-4) 0;
  }
  .see-all {
    font-size: 16px;
  }
  .search {
    display: flex;
    flex-grow: 1;
    justify-content: end;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  ul li {
    width: calc(50% - 1rem);
  }
  ul li * {
    text-decoration: none;
    transition: 0.2s ease;
  }
  ul li:first-child {
    width: 100%;
    margin-bottom: 1rem;
    text-align: center;
  }
  ul li:first-child .thumbnail {
    aspect-ratio: 21/9;
  }
  ul li .thumbnail {
    width: 100%;
    display: block;
    aspect-ratio: 16/9;
    overflow: hidden;
    margin: 0 auto;
    border-radius: 12px;
    margin-bottom: 0.5rem;
  }
  ul li a {
    display: block;
  }
  .title {
    color: rgb(var(--black));
    font-size: 1.2rem;
    line-height: 1.4;
    margin: 0;
  }
  .date {
    color: rgb(var(--gray));
    font-size: 15px;
    margin: 0;
  }
  ul li a:hover .title,
  ul li a:hover .date {
    color: rgb(var(--accent));
  }
  ul a:hover .thumbnail {
    box-shadow: var(--box-shadow);
  }
  @media (max-width: 720px) {
    .tag-search-area {
      flex-direction: column;
      align-items: end;
    }
    .search {
      width: 100%;
      pagefind-searchbox {
        width: 100%;
      }
    }
    ul {
      gap: 0.75em;
    }
    ul li {
      width: 100%;
      text-align: start;
    }
    ul li:first-child {
      margin-bottom: 0;
      text-align: start;
    }
    ul li:first-child .thumbnail {
      aspect-ratio: 16/9;
    }
  }
</style>
