---
import { SITE_TITLE } from "../consts";
import paths from "../pages/paths";
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
---

<header>
  <nav>
    <div class="nav-group">
      <a href="/" class="title">{SITE_TITLE}</a>
      <div class="internal-links">
        <HeaderLink href=`/${paths.root.url}`>{paths.root.name}</HeaderLink>
        <HeaderLink href=`/${paths.posts.url}`>{paths.posts.name}</HeaderLink>
        <HeaderLink href=`/${paths.about.url}`>{paths.about.name}</HeaderLink>
      </div>
    </div>
    <SocialLinks height="24px" />
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  nav {
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    height: 100%;
    line-height: 1.5;
    color: rgb(var(--black));
    border-bottom: 3px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  .nav-group {
    height: 100%;
    display: flex;
    flex-direction: row;
    align-items: start;
    gap: 12px;
  }
  .title {
    display: flex;
    align-items: center;
    max-width: 200px;
    font-weight: 300;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 200ms ease-in-out;
    margin: 0px;
  }
  @media (max-width: 540px) {
    .title {
      max-width: 0px;
      padding: 0;
    }
  }
  .internal-links {
    height: calc(100% - 3px);
    display: flex;
    align-items: flex-start;
    a {
      padding: 0px 0.75rem;
    }
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  @media (max-width: 720px) {
    .social-links {
      display: none;
    }
  }
</style>
