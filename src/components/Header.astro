---
import { SITE_TITLE } from "../consts";
import paths from "../pages/paths";
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
---

<header>
  <nav>
    <div class="nav-group">
      <a href="/" class="title">{SITE_TITLE}</a>
      <div class="internal-links">
        <HeaderLink href=`/${paths.root.url}`>{paths.root.name}</HeaderLink>
        <HeaderLink href=`/${paths.posts.url}`>{paths.posts.name}</HeaderLink>
        <HeaderLink href=`/${paths.about.url}`>{paths.about.name}</HeaderLink>
      </div>
    </div>
    <div class="social-links">
      <SocialLinks height="24px" />
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  nav {
    height: 48px;
    display: flex;
    align-items: start;
    justify-content: space-between;
  }
  /* nav a {
    height: 100%;
    line-height: 1.5;
    color: rgb(var(--black));
    border-bottom: 3px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  } */
  .nav-group {
    height: 100%;
    display: flex;
    flex-direction: row;
    align-items: start;
    gap: 12px;
  }
  .nav-group a {
    height: 100%;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    color: rgb(var(--black));
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .title {
    max-width: 200px;
    font-weight: 300;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 200ms ease-in-out;
  }
  @media (max-width: 540px) {
    .title {
      max-width: 0px;
      padding: 0;
    }
  }
  .internal-links {
    height: 100%;
    display: flex;
    a {
      padding: 0px 0.75rem;
    }
    a.active {
      border-bottom-color: var(--accent);
    }
  }
  .social-links {
    height: 100%;
    display: flex;
    align-items: center;
  }
  .social-links a {
    display: flex;
  }
</style>
