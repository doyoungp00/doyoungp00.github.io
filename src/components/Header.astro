---
import { SITE_TITLE } from "../consts";
import paths from "../pages/paths";
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
---

<header>
  <nav>
    <h2><a href="/">{SITE_TITLE}</a></h2>
    <div class="internal-links">
      <HeaderLink href=`/${paths.root.url}`>{paths.root.name}</HeaderLink>
      <HeaderLink href=`/${paths.posts.url}`>{paths.posts.name}</HeaderLink>
      <HeaderLink href=`/${paths.about.url}`>{paths.about.name}</HeaderLink>
    </div>
    <SocialLinks height="24px" />
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    height: 3em;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    line-height: 1.5;
    padding: 0.75em;
    color: var(--black);
    border-bottom: 3px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  @media (max-width: 720px) {
    .social-links {
      display: none;
    }
  }
</style>
