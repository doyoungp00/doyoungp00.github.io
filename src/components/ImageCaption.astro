---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"img"> {
  caption?: string;
}

const { caption, alt, ...props } = Astro.props;
---

<figure class="imagecaption">
  <img class="imagecaption-img" alt={alt} {...props} />
  {
    (caption || alt) && (
      <figcaption class="imagecaption-figc" aria-hidden="true">
        {caption ?? alt}
      </figcaption>
    )
  }
</figure>

<script>
  document.querySelectorAll(".imagecaption-img").forEach((img) => {
    img.addEventListener("error", () => {
      img.parentElement?.querySelector(".imagecaption-figc")?.remove();
    });
  });
</script>

<style>
  .imagecaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;

    img {
      object-fit: contain;
    }
  }
  .imagecaption-figc {
    color: rgb(var(--gray));
    font-size: 15px;
    text-align: center;
    margin-top: 6px;
  }
</style>
