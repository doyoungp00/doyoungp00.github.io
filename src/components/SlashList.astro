---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<span class="slash-list">
  {
    items.map((item, index) => (
      <>
        <span class="item">{item}</span>
        {index < items.length - 1 && <span class="separator">/</span>}
      </>
    ))
  }
</span>

<style>
  .slash-list {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .separator {
    display: inline-block;
    margin: 0 8px;
    font-size: 0.8rem;
    font-weight: 300;
    color: rgb(var(--gray));
  }
</style>
