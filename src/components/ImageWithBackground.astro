---
const { src, alt = "", class: className = "", style = "" } = Astro.props;
console.log(src);
---

<div class:list={["image-container", className]} style={style}>
  <img class="background" src={src} alt="" aria-hidden="true" />
  <img class="foreground" src={src} alt={alt} />
</div>

<style>
  .image-container {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    background: #222;
  }

  .background,
  .foreground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .background {
    object-fit: cover;
    filter: blur(20px);
    transform: scale(1.1);
    opacity: 0.7;
  }

  .foreground {
    object-fit: contain;
  }
</style>
