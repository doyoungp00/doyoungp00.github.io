---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";
import ImageWithBackground from "@/components/ImageWithBackground.astro";
import Tag from "@/components/Tag.astro";
import TagIcon from "@/components/TagIcon.astro";
import type paths from "@/utils/paths";
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<typeof paths.posts.url>["data"];

const { title, description, pubDate, updatedDate, heroImage, tags } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .hero-image {
        width: 100%;
        display: block;
        aspect-ratio: 16/9;
        object-fit: cover;
        overflow: hidden;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        width: 720px;
        max-width: calc(100% - var(--space-8));
        margin: auto;
        padding: var(--space-4);
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: var(--space-4);
        padding: var(--space-4) 0;
        line-height: 1.5;
      }
      .date {
        color: rgb(var(--gray));
        font-size: 15px;
        margin-bottom: var(--space-4);
      }
      .last-updated-on {
        font-style: italic;
      }
      .tags {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        color: rgb(var(--gray));
        font-size: 16px;
        svg {
          margin-right: var(--space-2);
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        {
          heroImage && (
            <div class="hero-image">
              <ImageWithBackground src={heroImage} alt="" />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            <h4>{title}</h4>
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <div class="tags">
              <TagIcon size="22px" />
              {
                tags?.length
                  ? tags.map((tag, idx) => (
                      <Fragment>
                        <Tag name={tag} />
                        {idx < tags.length - 1 && <span>,&nbsp;</span>}
                      </Fragment>
                    ))
                  : "No tags"
              }
            </div>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
