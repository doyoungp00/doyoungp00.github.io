---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ImageWithBackground from "../components/ImageWithBackground.astro";
import Tag from "../components/Tag.astro";
import type paths from "../pages/paths";

type Props = CollectionEntry<typeof paths.posts.url>["data"];

const { title, description, pubDate, updatedDate, heroImage, tags } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .hero-image {
        width: 100%;
        display: block;
        aspect-ratio: 16/9;
        object-fit: cover;
        overflow: hidden;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        width: 720px;
        max-width: calc(100% - var(--space-8));
        margin: auto;
        padding: var(--space-4);
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: var(--space-4);
        padding: var(--space-4) 0;
        line-height: 1.5;
      }
      .date {
        margin-bottom: var(--space-4);
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }
      .tags {
        display: flex;
        flex-direction: row;
        align-items: center;
        color: rgb(var(--gray));
        font-size: 16px;
        svg {
          margin-right: var(--space-2);
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        {
          heroImage && (
            <div class="hero-image">
              <ImageWithBackground src={heroImage.src} alt="" />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            <h3>{title}</h3>
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <div class="tags">
              <svg
                width="22px"
                height="22px"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M11.5808 5.10265L21.3421 14.8639L13.8639 22.3421L4.10261 12.5808L3.73898 4.73901L11.5808 5.10265Z"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M7 8L7 8.01"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              {
                tags?.length
                  ? tags.map((tag, idx) => (
                      <Fragment>
                        <Tag name={tag} />
                        {idx < tags.length - 1 && <span>,&nbsp;</span>}
                      </Fragment>
                    ))
                  : "No tags"
              }
            </div>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
